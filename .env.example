# ─────────────────────────────────────────────────────────────
#  Copiați acest fișier ca ".env" și completați valorile.
# ─────────────────────────────────────────────────────────────

# Portul pe care rulează serverul
PORT=3000

# Parola pentru panoul de administrare (http://localhost:3000/admin)
# SCHIMBAȚI-O înainte de a pune botul online!
ADMIN_PASSWORD=schimba-ma

# Domeniile care au voie să folosească widget-ul (separate prin virgulă).
# Lăsați "*" pentru teste. Exemplu producție: https://clinica-mea.ro,https://www.clinica-mea.ro
ALLOWED_ORIGINS=*

# ── WhatsApp Cloud API (Meta) ────────────────────────────────
# Le găsiți în Meta for Developers → aplicația dvs. → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Un text ales de dvs.; îl introduceți identic și în Meta la configurarea Webhook-ului
WHATSAPP_VERIFY_TOKEN=un-text-secret-ales-de-mine
# App Secret (Settings → Basic) — verifică faptul că mesajele vin chiar de la Meta
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# ── Răspunsuri AI (opțional) ─────────────────────────────────
# Dacă setați o cheie, botul răspunde inteligent și la întrebări
# pe care nu le are în lista de întrebări frecvente.
# Fără cheie, botul funcționează complet, doar pe reguli.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
